<!-- activity_mainpage.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/editTextVideoUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter YouTube Video URL"
        android:layout_margin="20dp"/>

    <Button
        android:id="@+id/buttonPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextVideoUrl"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:text="Play"/>

    <Button
        android:id="@+id/buttonAddToPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonPlay"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:text="Add to Playlist"/>

    <Button
        android:id="@+id/buttonMyPlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonAddToPlaylist"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:text="My Playlist"/>
</RelativeLayout>
